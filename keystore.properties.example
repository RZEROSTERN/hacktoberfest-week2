# Copy to keystore.properties (git-ignored) and fill in to build a signed release APK:
#   ./gradlew assembleRelease
# Create a key with:
#   keytool -genkeypair -keystore keystore/nature-quest-release.jks -alias naturequest \
#     -keyalg RSA -keysize 4096 -validity 10000 -dname "CN=Nature Quest"
storeFile=keystore/nature-quest-release.jks
storePassword=CHANGE_ME
keyAlias=naturequest
keyPassword=CHANGE_ME
